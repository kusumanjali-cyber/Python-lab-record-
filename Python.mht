	name=input("-1 for default: ")
	if name =="-1":
		name="Dude"
	age=input("-1 for default: ")
	if age =="-1":
		age=0
	else:
		age=int(age)
	country=input("-1 for default: ")
	if country=="-1":
		country="Space"
